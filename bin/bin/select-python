#!/usr/bin/env bash
#/ Usage:
#/   select-python
#/   select-python --current
#/   select-python --set <value>
#/ Select, inspect, or set Python runtime on Linux (RH-like, Debian-like, Arch-like).
set -euo pipefail

show_help() {
	grep '^#/' <"$0" | cut -c4-
}

mode="interactive"
set_value=""

while [ $# -gt 0 ]; do
	case "$1" in
	-h|--help)
		show_help
		exit 2
		;;
	--current)
		if [ "$mode" != "interactive" ]; then
			echo "Error: use only one mode (--current or --set)." >&2
			exit 1
		fi
		mode="current"
		shift
		;;
	--set)
		if [ "$mode" != "interactive" ]; then
			echo "Error: use only one mode (--current or --set)." >&2
			exit 1
		fi
		if [ $# -lt 2 ]; then
			echo "Error: missing value for --set." >&2
			exit 1
		fi
		mode="set"
		set_value="$2"
		shift 2
		;;
	*)
		echo "Error: unknown option '$1'." >&2
		show_help >&2
		exit 1
		;;
	esac
done

run_as_root() {
	if [ "$(id -u)" -eq 0 ]; then
		"$@"
	elif command -v sudo >/dev/null 2>&1; then
		sudo "$@"
	else
		echo "Error: root privileges required (run as root or install sudo)." >&2
		exit 1
	fi
}

ensure_linux() {
	if [ "$(uname -s)" != "Linux" ]; then
		echo "Error: unsupported platform '$(uname -s)'. Linux only." >&2
		exit 1
	fi

	if [ ! -r /etc/os-release ]; then
		echo "Error: /etc/os-release not found; unsupported Linux distribution." >&2
		exit 1
	fi
}

detect_linux_family() {
	# shellcheck disable=SC1091
	. /etc/os-release
	local meta
	meta="${ID:-} ${ID_LIKE:-}"

	case " $meta " in
	*" rhel "*|*" fedora "*|*" centos "*|*" rocky "*|*" almalinux "*|*|*" ol "*)
		echo "rh"
		;;
	*" debian "*|*" ubuntu "*|*" linuxmint "*|*" pop "*)
		echo "debian"
		;;
	*" arch "*|*" manjaro "*|*" endeavouros "*)
		echo "arch"
		;;
	*)
		echo ""
		;;
	esac
}

list_alternative_paths() {
	local selector_cmd="$1"
	local group="$2"

	if "$selector_cmd" --list "$group" >/dev/null 2>&1; then
		"$selector_cmd" --list "$group"
		return 0
	fi

	"$selector_cmd" --display "$group" 2>/dev/null | awk '/^\// {print $1}'
}

resolve_selector_cmd() {
	case "$linux_family" in
	rh)
		if command -v alternatives >/dev/null 2>&1; then
			echo "alternatives"
		else
			echo ""
		fi
		;;
	debian)
		if command -v update-alternatives >/dev/null 2>&1; then
			echo "update-alternatives"
		else
			echo ""
		fi
		;;
	arch)
		if command -v update-alternatives >/dev/null 2>&1; then
			echo "update-alternatives"
		elif command -v alternatives >/dev/null 2>&1; then
			echo "alternatives"
		else
			echo ""
		fi
		;;
	*)
		echo ""
		;;
	esac
}

resolve_group_name() {
	local selector_cmd="$1"
	local candidate
	for candidate in python3 python; do
		if [ -n "$(list_alternative_paths "$selector_cmd" "$candidate")" ]; then
			echo "$candidate"
			return 0
		fi
	done
	echo ""
}

current_python_command() {
	if command -v python3 >/dev/null 2>&1; then
		echo "python3"
	elif command -v python >/dev/null 2>&1; then
		echo "python"
	else
		echo ""
	fi
}

print_current() {
	local cmd_name
	cmd_name="$(current_python_command)"
	if [ -z "$cmd_name" ]; then
		echo "Error: no active Python command found in PATH." >&2
		exit 1
	fi
	readlink -f "$(command -v "$cmd_name")"
}

resolve_target_path() {
	local selector_cmd="$1"
	local group="$2"
	local value="$3"
	local path
	local -a matches=()

	while IFS= read -r path; do
		[ -z "$path" ] && continue
		if [ "$path" = "$value" ] || [ "$(basename "$path")" = "$value" ]; then
			matches+=("$path")
		fi
	done <<EOF2
$(list_alternative_paths "$selector_cmd" "$group")
EOF2

	if [ "${#matches[@]}" -eq 1 ]; then
		echo "${matches[0]}"
		return 0
	fi

	if [ "${#matches[@]}" -gt 1 ]; then
		echo "Error: ambiguous value '$value'. Use full alternative path." >&2
		exit 1
	fi

	echo "Error: value '$value' not found for group '$group'." >&2
	echo "Available paths:" >&2
	list_alternative_paths "$selector_cmd" "$group" >&2
	exit 1
}

run_interactive() {
	run_as_root "$selector_cmd" --config "$group_name"
}

run_set() {
	local target_path
	target_path="$(resolve_target_path "$selector_cmd" "$group_name" "$set_value")"
	run_as_root "$selector_cmd" --set "$group_name" "$target_path"
}

ensure_linux

linux_family="$(detect_linux_family)"
if [ -z "$linux_family" ]; then
	# shellcheck disable=SC1091
	. /etc/os-release
	echo "Error: unsupported Linux distribution family (ID='${ID:-unknown}', ID_LIKE='${ID_LIKE:-unknown}')." >&2
	exit 1
fi

selector_cmd="$(resolve_selector_cmd)"
if [ -z "$selector_cmd" ]; then
	echo "Error: alternatives tool not found for this distro family." >&2
	exit 1
fi

group_name="$(resolve_group_name "$selector_cmd")"
if [ -z "$group_name" ]; then
	echo "Error: no alternatives group found for Python (tried: python3, python)." >&2
	exit 1
fi

case "$mode" in
interactive)
	run_interactive
	;;
current)
	print_current
	;;
set)
	run_set
	;;
*)
	echo "Error: internal mode error '$mode'." >&2
	exit 1
	;;
esac
