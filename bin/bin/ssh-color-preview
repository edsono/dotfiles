#!/usr/bin/env bash
#/ Usage: ssh-color-preview
#/ Compare the colors used by the SSH banner and remote prompt.
set -e

reset=$'\033[0m'
bold=$'\033[1m'

show_color() {
  local role="$1"
  local hex="$2"
  local red="$3"
  local green="$4"
  local blue="$5"
  local example="$6"

  printf '\033[48;2;%s;%s;%sm   %s  %-13s %-7s ' \
    "$red" "$green" "$blue" "$reset" "$role" "$hex"
  printf '\033[38;2;%s;%s;%sm%s%s\n' \
    "$red" "$green" "$blue" "$example" "$reset"
}

printf '%sCores atuais do banner e do prompt SSH%s\n\n' "$bold" "$reset"
show_color "Logo" "#0087FF" 0 135 255 "#####"
show_color "Distribuição" "#00D7FF" 0 215 255 "AlmaLinux 9.8"
show_color "Rótulos" "#00AFFF" 0 175 255 "Kernel · Uptime · IP"
show_color "Valores" "#EEEEEE" 238 238 238 "5.14.0 · 18h · 192.0.2.10"
show_color "Auxiliares" "#8A8A8A" 138 138 138 "automação em 18h · sudo dnf upgrade"
show_color "Prompt SSH" "#8FB2E4" 143 178 228 "󰌘 kinghost"

printf '\n%sComparação lado a lado%s\n\n' "$bold" "$reset"
printf '\033[38;2;0;135;255mLogo%s  ' "$reset"
printf '\033[38;2;0;215;255mDistribuição%s  ' "$reset"
printf '\033[38;2;0;175;255mRótulo%s  ' "$reset"
printf '\033[38;2;238;238;238mValor%s  ' "$reset"
printf '\033[38;2;138;138;138mAuxiliar%s  ' "$reset"
printf '\033[1;38;2;143;178;228m󰌘 Prompt SSH%s\n' "$reset"
