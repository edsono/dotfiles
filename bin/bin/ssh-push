#!/usr/bin/env bash
#/ Usage: ssh-push [ssh-vps options] <host> [host...]
#/ Deprecated compatibility wrapper for ssh-vps.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

for argument in "$@"; do
  if [ "$argument" = "--force" ]; then
    echo "Error: --force was removed because Git-managed dotfiles never overwrite local changes." >&2
    echo "Run ssh-vps after resolving the remote repository state." >&2
    exit 2
  fi
done

echo "Warning: ssh-push is deprecated; use ssh-vps instead." >&2
exec "${script_dir}/ssh-vps" "$@"
