#!/usr/bin/env bash
#/ Usage: ssh-push <host> [host...]
#/ Push SSH key and sync dotfiles to remote host(s).
set -euo pipefail

show_help() {
	grep '^#/' <"$0" | cut -c4-
}

if [ $# -eq 0 ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
	show_help
	exit 2
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd "${script_dir}/../.." && pwd -P)"

ensure_local_prereqs() {
	if ! command -v ssh >/dev/null 2>&1; then
		echo "Error: required command 'ssh' not found." >&2
		exit 1
	fi
	if ! command -v scp >/dev/null 2>&1; then
		echo "Error: required command 'scp' not found." >&2
		exit 1
	fi
}

ensure_local_key() {
	mkdir -p "${HOME}/.ssh"
	chmod 700 "${HOME}/.ssh"

	if [ -f "${HOME}/.ssh/id_ed25519.pub" ]; then
		echo "${HOME}/.ssh/id_ed25519.pub"
		return 0
	fi

	if [ -f "${HOME}/.ssh/id_rsa.pub" ]; then
		echo "${HOME}/.ssh/id_rsa.pub"
		return 0
	fi

	ssh-keygen -t ed25519 -N "" -f "${HOME}/.ssh/id_ed25519"
	echo "${HOME}/.ssh/id_ed25519.pub"
}

push_key_to_host() {
	local host="$1"
	local public_key_file="$2"

	if command -v ssh-copy-id >/dev/null 2>&1; then
		ssh-copy-id -i "${public_key_file}" "${host}"
		return 0
	fi

	# Fallback when ssh-copy-id is unavailable.
	ssh "${host}" 'umask 077; mkdir -p ~/.ssh; touch ~/.ssh/authorized_keys'
	cat "${public_key_file}" | ssh "${host}" 'cat >> ~/.ssh/authorized_keys'
}

sync_dotfiles_rsync() {
	local host="$1"
	rsync -az --exclude '.git/' "${repo_root}/" "${host}:~/.dotfiles/"
}

sync_dotfiles_scp_fallback() {
	local host="$1"
	ssh "${host}" 'mkdir -p ~/.dotfiles'
	scp -r \
		"${repo_root}/bin" \
		"${repo_root}/git" \
		"${repo_root}/nvim" \
		"${repo_root}/tmux" \
		"${repo_root}/zsh" \
		"${repo_root}/AGENTS.md" \
		"${repo_root}/README.md" \
		"${repo_root}/install.sh" \
		"${repo_root}/LICENSE" \
		"${host}:~/.dotfiles/"
}

sync_dotfiles() {
	local host="$1"

	if command -v rsync >/dev/null 2>&1; then
		if sync_dotfiles_rsync "${host}"; then
			return 0
		fi
		echo "Warning: rsync failed for ${host}; falling back to scp." >&2
	fi

	sync_dotfiles_scp_fallback "${host}"
}

apply_remote_stow() {
	local host="$1"
	ssh "${host}" '
		if ! command -v stow >/dev/null 2>&1; then
			echo "Error: stow is required on remote host." >&2
			exit 1
		fi
		cd ~/.dotfiles
		stow -t ~ zsh tmux git bin nvim
	'
}

ensure_local_prereqs
public_key_file="$(ensure_local_key)"

for host in "$@"; do
	push_key_to_host "${host}" "${public_key_file}"
	sync_dotfiles "${host}"
	apply_remote_stow "${host}"
done
