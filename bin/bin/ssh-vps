#!/usr/bin/env bash
#/ Usage: ssh-vps [options] <host> [host...]
#/ Provision AlmaLinux/RHEL hosts and apply a Git-managed dotfiles subset.
set -euo pipefail

REPO_URL="https://github.com/edsono/dotfiles.git"
REPO_BRANCH="main"
PACKAGES_CSV="zsh,git,tmux,bin,vim,bat"
PUBLIC_KEY_FILE=""
DRY_RUN=0
SKIP_KEY_PUSH=0
hosts=()

show_help() {
  grep '^#/' <"$0" | cut -c4-
  cat <<'EOF'

Options:
  --key <pubkey>       Use an explicit local SSH public key
  --packages <list>    Comma-separated Stow packages
                       (default: zsh,git,tmux,bin,vim,bat)
  --dry-run            Inspect hosts and show planned actions
  --skip-key-push      Assume the SSH key is already authorized
  -h, --help           Show this help
EOF
}

log_step() {
  local host="$1"
  local message="$2"
  printf '[%s] %s: %s\n' "$(date '+%H:%M:%S')" "$host" "$message"
}

die() {
  echo "Error: $*" >&2
  exit 1
}

ensure_local_key() {
  if [ -n "$PUBLIC_KEY_FILE" ]; then
    [ -f "$PUBLIC_KEY_FILE" ] || die "public key file not found: $PUBLIC_KEY_FILE"
    return
  fi

  if [ -f "${HOME}/.ssh/id_ed25519.pub" ]; then
    PUBLIC_KEY_FILE="${HOME}/.ssh/id_ed25519.pub"
  elif [ -f "${HOME}/.ssh/id_rsa.pub" ]; then
    PUBLIC_KEY_FILE="${HOME}/.ssh/id_rsa.pub"
  else
    die "no local SSH public key found in ~/.ssh"
  fi
}

push_key_to_host() {
  local host="$1"

  if command -v ssh-copy-id >/dev/null 2>&1; then
    ssh-copy-id -i "$PUBLIC_KEY_FILE" "$host"
    return
  fi

  cat "$PUBLIC_KEY_FILE" | ssh "$host" '
    set -e
    umask 077
    mkdir -p ~/.ssh
    touch ~/.ssh/authorized_keys
    IFS= read -r key
    grep -qxF "$key" ~/.ssh/authorized_keys ||
      printf "%s\n" "$key" >> ~/.ssh/authorized_keys
  '
}

validate_packages() {
  local package_name
  local packages="${PACKAGES_CSV//,/ }"

  for package_name in $packages; do
    case "$package_name" in
      zsh|git|tmux|bin|vim|bat) ;;
      *) die "unsupported VPS package: $package_name" ;;
    esac
  done
}

remote_run() {
  local host="$1"
  local mode="$2"

  ssh "$host" \
    "DOTFILES_MODE='$mode' DOTFILES_REPO_URL='$REPO_URL' DOTFILES_REPO_BRANCH='$REPO_BRANCH' DOTFILES_PACKAGES='${PACKAGES_CSV//,/ }' bash -s" <<'REMOTE'
set -euo pipefail

run_as_root() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo -n "$@"
  else
    echo "Error: root privileges are required." >&2
    return 1
  fi
}

ensure_dnf_packages() {
  command -v dnf >/dev/null 2>&1 || {
    echo "Error: dnf is required on the remote host." >&2
    exit 1
  }

  run_as_root dnf -y install epel-release dnf-plugins-core
  if ! rpm -q starship >/dev/null 2>&1 && ! dnf -q list --available starship >/dev/null 2>&1; then
    run_as_root dnf -y copr enable atim/starship
  fi
  run_as_root dnf -y install \
    stow git tmux ripgrep fd-find jq fzf htop zsh vim-enhanced \
    starship zoxide duf procs ncdu bat git-delta
}

ensure_git_clone() {
  local backup_path=""
  local current_branch=""
  local current_origin=""

  if [ -e "${HOME}/.dotfiles" ] && ! git -C "${HOME}/.dotfiles" rev-parse \
    --is-inside-work-tree >/dev/null 2>&1; then
    backup_path="${HOME}/.dotfiles-backups/$(date +%Y%m%d-%H%M%S)-$$/dotfiles"
    mkdir -p "$(dirname "$backup_path")"
    mv "${HOME}/.dotfiles" "$backup_path"
    echo "Backed up previous dotfiles to ${backup_path}"
  fi

  if [ ! -d "${HOME}/.dotfiles/.git" ]; then
    if ! git clone --branch "$DOTFILES_REPO_BRANCH" --single-branch \
      "$DOTFILES_REPO_URL" "${HOME}/.dotfiles"; then
      if [ -n "$backup_path" ] && [ ! -e "${HOME}/.dotfiles" ]; then
        mv "$backup_path" "${HOME}/.dotfiles"
      fi
      exit 1
    fi
  fi

  current_origin="$(git -C "${HOME}/.dotfiles" remote get-url origin)"
  [ "$current_origin" = "$DOTFILES_REPO_URL" ] || {
    echo "Error: unexpected dotfiles origin: ${current_origin}" >&2
    exit 1
  }

  current_branch="$(git -C "${HOME}/.dotfiles" branch --show-current)"
  [ "$current_branch" = "$DOTFILES_REPO_BRANCH" ] || {
    echo "Error: expected branch ${DOTFILES_REPO_BRANCH}, found ${current_branch}." >&2
    exit 1
  }

  if [ -n "$(git -C "${HOME}/.dotfiles" status --porcelain)" ]; then
    echo "Error: ~/.dotfiles has local changes; refusing to update." >&2
    git -C "${HOME}/.dotfiles" status --short >&2
    exit 1
  fi

  git -C "${HOME}/.dotfiles" pull --ff-only origin "$DOTFILES_REPO_BRANCH"
}

apply_dotfiles() {
  local conflict_output=""

  cd "${HOME}/.dotfiles"
  conflict_output="$(stow -n -v -t "$HOME" $DOTFILES_PACKAGES 2>&1 || true)"
  if printf '%s\n' "$conflict_output" | grep -q 'existing target'; then
    printf '%s\n' "$conflict_output" >&2
    echo "Error: Stow conflicts detected; no files were overwritten." >&2
    exit 1
  fi

  stow -t "$HOME" $DOTFILES_PACKAGES
  if command -v bat >/dev/null 2>&1; then
    bat cache --build
  fi
}

ensure_local_overrides() {
  local marker_start="# >>> ssh-vps >>>"
  local marker_end="# <<< ssh-vps <<<"
  local zshrc_local="${HOME}/.zshrc-local"

  touch "$zshrc_local"
  awk -v begin="$marker_start" -v end="$marker_end" '
    $0 == begin { inside=1; next }
    $0 == end { inside=0; next }
    !inside { print }
  ' "$zshrc_local" >"${zshrc_local}.tmp"
  {
    printf '%s\n' "$marker_start"
    printf '%s\n' "export EDITOR=vim"
    printf '%s\n' "export VISUAL=vim"
    printf '%s\n' "$marker_end"
  } >>"${zshrc_local}.tmp"
  mv "${zshrc_local}.tmp" "$zshrc_local"
}

ensure_default_shell() {
  local current_shell
  local user_name
  local zsh_path

  user_name="$(id -un)"
  zsh_path="$(command -v zsh)"
  current_shell="$(getent passwd "$user_name" | cut -d: -f7)"
  [ "$current_shell" = "$zsh_path" ] || run_as_root usermod -s "$zsh_path" "$user_name"
}

show_dry_run() {
  if git -C "${HOME}/.dotfiles" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "dry-run: existing Git clone"
    echo "dry-run: origin=$(git -C "${HOME}/.dotfiles" remote get-url origin 2>/dev/null || echo missing)"
    echo "dry-run: branch=$(git -C "${HOME}/.dotfiles" branch --show-current)"
    git -C "${HOME}/.dotfiles" status --short
    echo "dry-run: would pull ${DOTFILES_REPO_BRANCH} with --ff-only"
  elif [ -e "${HOME}/.dotfiles" ]; then
    echo "dry-run: would back up non-Git ~/.dotfiles and clone ${DOTFILES_REPO_URL}"
  else
    echo "dry-run: would clone ${DOTFILES_REPO_URL} into ~/.dotfiles"
  fi
  echo "dry-run: would apply Stow packages: ${DOTFILES_PACKAGES}"
}

if [ "$DOTFILES_MODE" = "dry-run" ]; then
  show_dry_run
  exit 0
fi

ensure_dnf_packages
ensure_git_clone
apply_dotfiles
ensure_local_overrides
ensure_default_shell
REMOTE
}

while [ $# -gt 0 ]; do
  case "$1" in
    --key)
      shift
      [ $# -gt 0 ] || die "--key requires a file path"
      PUBLIC_KEY_FILE="$1"
      ;;
    --packages)
      shift
      [ $# -gt 0 ] || die "--packages requires a value"
      PACKAGES_CSV="$1"
      ;;
    --dry-run)
      DRY_RUN=1
      ;;
    --skip-key-push)
      SKIP_KEY_PUSH=1
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    *)
      hosts+=("$1")
      ;;
  esac
  shift
done

[ "${#hosts[@]}" -gt 0 ] || {
  show_help
  exit 2
}
command -v ssh >/dev/null 2>&1 || die "required command 'ssh' not found"
validate_packages

if [ "$SKIP_KEY_PUSH" -eq 0 ] && [ "$DRY_RUN" -eq 0 ]; then
  ensure_local_key
fi

for host in "${hosts[@]}"; do
  log_step "$host" "start"
  if [ "$SKIP_KEY_PUSH" -eq 0 ] && [ "$DRY_RUN" -eq 0 ]; then
    log_step "$host" "authorizing SSH key"
    push_key_to_host "$host"
  fi
  if [ "$DRY_RUN" -eq 1 ]; then
    remote_run "$host" dry-run
  else
    remote_run "$host" apply
  fi
  log_step "$host" "done"
done
