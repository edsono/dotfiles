# Ghostty base config (Linux/Unix - XDG path)
# Keep this file portable and machine-agnostic.
# Put machine/system-specific settings in:
#   ~/.config/ghostty/config.local

theme = Synthwave
shell-integration-features = cursor,no-sudo,title
font-family = JetBrainsMono Nerd Font Mono
font-size = 10

# Local overrides (optional).
# Use this for Omarchy integration, keybinds, window tuning, etc.
config-file = ?~/.config/ghostty/config.local
