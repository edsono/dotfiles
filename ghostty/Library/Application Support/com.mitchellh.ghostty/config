# Ghostty base config (macOS - Application Support path)
# Keep this file portable and machine-agnostic.
# Put machine/system-specific settings in:
#   ~/Library/Application Support/com.mitchellh.ghostty/config.local

theme = Synthwave
shell-integration-features = ssh-terminfo,ssh-env
font-family = JetBrainsMono Nerd Font Mono
font-size = 10

# Local overrides (optional).
# Use this for Omarchy integration, keybinds, window tuning, etc.
config-file = ?~/Library/Application Support/com.mitchellh.ghostty/config.local
