# Example local overrides for Ghostty (macOS).
# Copy to ~/Library/Application Support/com.mitchellh.ghostty/config.local
# and adjust per machine.

# Omarchy dynamic theme (optional).
# Keep this only on machines that have Omarchy.
# config-file = ?~/.config/omarchy/current/theme/ghostty.conf

# Window tuning.
# window-padding-x = 14
# window-padding-y = 14
# confirm-close-surface = false
# resize-overlay = never

# Cursor tuning.
# cursor-style = block
# cursor-style-blink = false

# If you prefer disabling cursor integration:
# shell-integration-features = no-cursor,ssh-env

# Keybindings.
# keybind = shift+insert=paste_from_clipboard
# keybind = control+insert=copy_to_clipboard

# Scrolling.
# mouse-scroll-multiplier = 0.95
