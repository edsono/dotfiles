#!/usr/bin/env bash
set -euo pipefail

CACHE_FILE="/var/cache/dotfiles-ssh-banner/status"
CACHE_TTL=129600

generated_at=""
status=""
count=-1
reboot_required="desconhecido"

if [ -r "$CACHE_FILE" ]; then
  while IFS='=' read -r key value; do
    case "$key" in
      generated_at) generated_at="$value" ;;
      status) status="$value" ;;
      count) count="$value" ;;
      reboot_required) reboot_required="$value" ;;
    esac
  done < "$CACHE_FILE"
fi

logo_color=""
heading_color=""
label_color=""
value_color=""
distro_color=""
muted_color=""
yellow=""
red=""
reset=""
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != "dumb" ]; then
  heading_color=$'\033[1;37m'
  label_color=$'\033[1;38;5;39m'
  value_color=$'\033[38;5;255m'
  distro_color=$'\033[1;38;5;45m'
  muted_color=$'\033[38;5;245m'
  yellow=$'\033[1;33m'
  red=$'\033[1;31m'
  reset=$'\033[0m'
fi

hostname="$(hostname -f 2>/dev/null || hostname)"
os_id="linux"
os_name="Linux"
if [ -r /etc/os-release ]; then
  . /etc/os-release
  os_id="${ID:-linux}"
  os_name="${PRETTY_NAME:-Linux}"
fi
kernel="$(uname -r)"
uptime_text="$(uptime -p 2>/dev/null || true)"
uptime_text="${uptime_text#up }"
load="$(awk '{ print $1, $2, $3 }' /proc/loadavg)"

read -r memory_total memory_available < <(
  awk '
    $1 == "MemTotal:" { total = $2 }
    $1 == "MemAvailable:" { available = $2 }
    END { print total, available }
  ' /proc/meminfo
)
memory_used=$((memory_total - memory_available))
memory_percent=$((memory_used * 100 / memory_total))
memory_used_mib=$((memory_used / 1024))
memory_total_mib=$((memory_total / 1024))

read -r disk_total disk_used disk_percent < <(
  df -hP / | awk 'NR == 2 { print $2, $3, $5 }'
)

ip_address="$(
  ip route get 1.1.1.1 2>/dev/null |
    awk '{ for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit } }'
)" || true
if [ -z "$ip_address" ]; then
  ip_address="$(
    ip -4 -o address show scope global 2>/dev/null |
      awk 'NR == 1 { split($4, address, "/"); print address[1] }'
  )" || true
fi
ip_address="${ip_address:-indisponível}"

cache_is_old=0
updates="indisponíveis"
if [[ "$count" =~ ^[0-9]+$ ]]; then
  updates="$count"
  now="$(date +%s)"
  if [[ "$generated_at" =~ ^[0-9]+$ ]] &&
    [ $((now - generated_at)) -gt "$CACHE_TTL" ]; then
    cache_is_old=1
  fi
fi

failed_unit_names="$(
  systemctl --failed --no-legend --plain 2>/dev/null |
    awk 'NF { names = names (names ? ", " : "") $1 } END { print names }'
)" || failed_unit_names=""

format_duration() {
  local remaining="$1"
  local days
  local hours
  local minutes

  if [ "$remaining" -le 0 ]; then
    echo "agora"
  elif [ "$remaining" -lt 3600 ]; then
    minutes=$(((remaining + 59) / 60))
    printf '%s min\n' "$minutes"
  elif [ "$remaining" -lt 172800 ]; then
    hours=$((remaining / 3600))
    printf '%sh\n' "$hours"
  else
    days=$((remaining / 86400))
    hours=$(((remaining % 86400) / 3600))
    printf '%sd %sh\n' "$days" "$hours"
  fi
}

next_timer_duration() {
  local timer="$1"
  local next_run
  local next_epoch
  local now

  next_run="$(
    systemctl show "$timer" \
      --property=NextElapseUSecRealtime --value 2>/dev/null
  )" || true
  [ -n "$next_run" ] || {
    echo "indisponível"
    return
  }
  next_epoch="$(date -d "$next_run" +%s 2>/dev/null)" || {
    echo "indisponível"
    return
  }
  now="$(date +%s)"
  format_duration "$((next_epoch - now))"
}

update_timer="$(next_timer_duration dnf-automatic.timer)"
reboot_timer="$(next_timer_duration dotfiles-reboot-if-required.timer)"

case "$os_id" in
  almalinux)
    if [ -n "$reset" ]; then
      logo_color=$'\033[38;5;33m'
    fi
    logo=(
      "       #####   "
      "      #######  "
      "      ##O#O##  "
      "      #######  "
      "    ###########"
      "   ############"
      "  #############"
      "   ########### "
    )
    ;;
  *)
    if [ -n "$reset" ]; then
      logo_color=$'\033[1;36m'
    fi
    logo=(
      "      .--.     "
      "     |o_o |    "
      "     |:_/ |    "
      "    //   \\ \\   "
      "   (|     | )  "
      "  /\\_   _/\\   "
      "  \\___)=(___/  "
      "     Linux     "
    )
    ;;
esac

details=(
  "${heading_color}${hostname}${reset}"
  "${distro_color}${os_name}${reset}"
  "${label_color}Kernel${reset} ${value_color}${kernel}${reset}"
  "${label_color}Uptime${reset} ${value_color}${uptime_text:-indisponível}${reset}"
  "${label_color}Carga${reset} ${value_color}${load}${reset}"
  "${label_color}Memória${reset} ${value_color}${memory_used_mib}/${memory_total_mib} MiB (${memory_percent}%)${reset}"
  "${label_color}Disco${reset} ${value_color}${disk_used}/${disk_total} (${disk_percent})${reset}"
  "${label_color}IP${reset} ${value_color}${ip_address}${reset} · ${label_color}Atualizações pendentes${reset} ${value_color}${updates}${reset}"
)

terminal_columns="${COLUMNS:-}"
if ! [[ "$terminal_columns" =~ ^[0-9]+$ ]]; then
  terminal_columns="$(tput cols 2>/dev/null || echo 80)"
fi

printf '\n'

if [ "$terminal_columns" -ge 80 ]; then
  for index in "${!logo[@]}"; do
    printf '%s%s%s  %b\n' \
      "$logo_color" "${logo[$index]}" "$reset" "${details[$index]}"
  done
else
  printf '%s%s%s\n' "$heading_color" "$hostname" "$reset"
  printf '  %s%s%s · %sKernel%s %s%s%s\n' \
    "$distro_color" "$os_name" "$reset" "$label_color" "$reset" \
    "$value_color" "$kernel" "$reset"
  printf '  %sUptime%s %s%s%s · %sCarga%s %s%s%s\n' \
    "$label_color" "$reset" "$value_color" \
    "${uptime_text:-indisponível}" "$reset" "$label_color" "$reset" \
    "$value_color" "$load" "$reset"
  printf '  %sMemória%s %s%s/%s MiB (%s%%)%s · %sDisco%s %s%s/%s (%s)%s\n' \
    "$label_color" "$reset" "$value_color" "$memory_used_mib" \
    "$memory_total_mib" "$memory_percent" "$reset" "$label_color" "$reset" \
    "$value_color" "$disk_used" "$disk_total" "$disk_percent" "$reset"
  printf '  %sIP%s %s%s%s · %sAtualizações pendentes%s %s%s%s\n' \
    "$label_color" "$reset" "$value_color" "$ip_address" "$reset" \
    "$label_color" "$reset" "$value_color" "$updates" "$reset"
fi

warning_messages=()
warning_commands=()
critical_messages=()
critical_commands=()

if [ "$status" != "ok" ]; then
  critical_messages+=("Não foi possível atualizar o cache de pacotes.")
  critical_commands+=("sudo systemctl restart dotfiles-ssh-banner-cache.service")
elif [ "$cache_is_old" -eq 1 ]; then
  warning_messages+=("O cache de atualizações está antigo.")
  warning_commands+=("sudo systemctl restart dotfiles-ssh-banner-cache.service")
elif [[ "$count" =~ ^[0-9]+$ ]] && [ "$count" -gt 0 ]; then
  warning_messages+=("${count} atualizações pendentes.")
  warning_commands+=("sudo dnf upgrade --refresh -y")
fi

if [ "$reboot_required" = "sim" ]; then
  critical_messages+=("Reinício necessário.")
  critical_commands+=("sudo systemctl reboot")
fi

if [ -n "$failed_unit_names" ]; then
  critical_messages+=("Serviços falhos: ${failed_unit_names}.")
  critical_commands+=(
    "systemctl status ${failed_unit_names//,/} --no-pager"
  )
fi

if [ "$terminal_columns" -ge 80 ]; then
  alert_indent="                 "
else
  alert_indent="  "
fi

if [ "$terminal_columns" -ge 80 ]; then
  printf '%s%sAutomação%s  %satualizações em %s%s%s%s · reinício em %s%s%s\n' \
    "$alert_indent" "$label_color" "$reset" "$value_color" \
    "$muted_color" "$update_timer" "$reset" "$value_color" \
    "$muted_color" "$reboot_timer" "$reset"
else
  printf '%s%sAutomação%s  %satualizações em %s%s%s\n' \
    "$alert_indent" "$label_color" "$reset" "$value_color" \
    "$muted_color" "$update_timer" "$reset"
  printf '%s           %sreinício em %s%s%s\n' \
    "$alert_indent" "$value_color" "$muted_color" "$reboot_timer" "$reset"
fi

if [ "${#warning_messages[@]}" -gt 0 ] ||
  [ "${#critical_messages[@]}" -gt 0 ]; then
  printf '\n'
fi

for index in "${!warning_messages[@]}"; do
  printf '%s%s%-2s %s%s\n' \
    "$alert_indent" "$yellow" "!" "${warning_messages[$index]}" "$reset"
  printf '%s   %s$%s %s%s%s\n' \
    "$alert_indent" "$label_color" "$reset" "$muted_color" \
    "${warning_commands[$index]}" "$reset"
done

if [ "${#warning_messages[@]}" -gt 0 ] &&
  [ "${#critical_messages[@]}" -gt 0 ]; then
  printf '\n'
fi

for index in "${!critical_messages[@]}"; do
  printf '%s%s%-2s %s%s\n' \
    "$alert_indent" "$red" "!!" "${critical_messages[$index]}" "$reset"
  printf '%s   %s$%s %s%s%s\n' \
    "$alert_indent" "$label_color" "$reset" "$muted_color" \
    "${critical_commands[$index]}" "$reset"
done

printf '\n'
